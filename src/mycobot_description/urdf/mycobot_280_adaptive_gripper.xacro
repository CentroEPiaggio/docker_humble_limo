<?xml version="1.0"?>
<!-- myCobot 280 M5 + adaptive gripper, converted from mycobot_ros2 mycobot_280_m5_adaptive_gripper.urdf
     (same joint names and kinematics as the real robot). Changes for Gazebo Fortress:
     links prefixed with ${prefix}, inertials added, non-zero velocity limits, file:// meshes.
     The gripper linkage is an open chain: the 5 former <mimic> joints are commanded by the
     launch-side gripper controller (see limo_simulation mycobot_sim_bridge.py). -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="mycobot_280_adaptive_gripper" params="prefix">
    <xacro:property name="mesh_dir" value="file://$(find mycobot_description)/meshes"/>
    <link name="${prefix}g_base">
      <visual><origin xyz="0 0 -0.03" rpy="0 0 1.5708"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/G_base.dae"/></geometry></visual>
      <collision><origin xyz="0 0 -0.03" rpy="0 0 1.5708"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/G_base.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.2"/><inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00012"/></inertial>
    </link>
    <link name="${prefix}joint1">
      <visual><origin xyz="0 0 0" rpy="0 0 -1.5708"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint1.dae"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 -1.5708"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint1.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.15"/><inertia ixx="9e-05" ixy="0" ixz="0" iyy="9e-05" iyz="0" izz="9e-05"/></inertial>
    </link>
    <link name="${prefix}joint2">
      <visual><origin xyz="0 0 -0.06096" rpy="0 0 -1.5708"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint2.dae"/></geometry></visual>
      <collision><origin xyz="0 0 -0.06096" rpy="0 0 -1.5708"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint2.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.12"/><inertia ixx="7.2e-05" ixy="0" ixz="0" iyy="7.2e-05" iyz="0" izz="7.2e-05"/></inertial>
    </link>
    <link name="${prefix}joint3">
      <visual><origin xyz="0 0 0.03256" rpy="0 -1.5708 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint3.dae"/></geometry></visual>
      <collision><origin xyz="0 0 0.03256" rpy="0 -1.5708 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint3.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.12"/><inertia ixx="7.2e-05" ixy="0" ixz="0" iyy="7.2e-05" iyz="0" izz="7.2e-05"/></inertial>
    </link>
    <link name="${prefix}joint4">
      <visual><origin xyz="0 0 0.03056" rpy="0 -1.5708 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint4.dae"/></geometry></visual>
      <collision><origin xyz="0 0 0.03056" rpy="0 -1.5708 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint4.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="6e-05" ixy="0" ixz="0" iyy="6e-05" iyz="0" izz="6e-05"/></inertial>
    </link>
    <link name="${prefix}joint5">
      <visual><origin xyz="0 0 -0.03356" rpy="-1.5708 0 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint5.dae"/></geometry></visual>
      <collision><origin xyz="0 0 -0.03356" rpy="-1.5708 0 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint5.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.08"/><inertia ixx="4.8e-05" ixy="0" ixz="0" iyy="4.8e-05" iyz="0" izz="4.8e-05"/></inertial>
    </link>
    <link name="${prefix}joint6">
      <visual><origin xyz="0 0 -0.038" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint6.dae"/></geometry></visual>
      <collision><origin xyz="0 0 -0.038" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint6.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.06"/><inertia ixx="3.6e-05" ixy="0" ixz="0" iyy="3.6e-05" iyz="0" izz="3.6e-05"/></inertial>
    </link>
    <link name="${prefix}joint6_flange">
      <visual><origin xyz="0 0 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint7.dae"/></geometry></visual>
      <collision><origin xyz="0 0 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/mycobot_280_m5/joint7.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.03"/><inertia ixx="1.8e-05" ixy="0" ixz="0" iyy="1.8e-05" iyz="0" izz="1.8e-05"/></inertial>
    </link>
    <link name="${prefix}gripper_base">
      <visual><origin xyz="0 0 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_base.dae"/></geometry></visual>
      <collision><origin xyz="0 0 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_base.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.07"/><inertia ixx="4.2e-05" ixy="0" ixz="0" iyy="4.2e-05" iyz="0" izz="4.2e-05"/></inertial>
    </link>
    <link name="${prefix}gripper_left1">
      <visual><origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_left1.dae"/></geometry></visual>
      <collision><origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_left1.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.01"/><inertia ixx="6e-06" ixy="0" ixz="0" iyy="6e-06" iyz="0" izz="6e-06"/></inertial>
    </link>
    <link name="${prefix}gripper_left2">
      <visual><origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_left2.dae"/></geometry></visual>
      <collision><origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_left2.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.01"/><inertia ixx="6e-06" ixy="0" ixz="0" iyy="6e-06" iyz="0" izz="6e-06"/></inertial>
    </link>
    <link name="${prefix}gripper_left3">
      <visual><origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_left3.dae"/></geometry></visual>
      <collision><origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_left3.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.01"/><inertia ixx="6e-06" ixy="0" ixz="0" iyy="6e-06" iyz="0" izz="6e-06"/></inertial>
    </link>
    <link name="${prefix}gripper_right1">
      <visual><origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_right1.dae"/></geometry></visual>
      <collision><origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_right1.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.01"/><inertia ixx="6e-06" ixy="0" ixz="0" iyy="6e-06" iyz="0" izz="6e-06"/></inertial>
    </link>
    <link name="${prefix}gripper_right2">
      <visual><origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_right2.dae"/></geometry></visual>
      <collision><origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_right2.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.01"/><inertia ixx="6e-06" ixy="0" ixz="0" iyy="6e-06" iyz="0" izz="6e-06"/></inertial>
    </link>
    <link name="${prefix}gripper_right3">
      <visual><origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_right3.dae"/></geometry></visual>
      <collision><origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/><geometry><mesh filename="${mesh_dir}/adaptive_gripper/gripper_right3.dae"/></geometry></collision>
      <inertial><origin xyz="0 0 0"/><mass value="0.01"/><inertia ixx="6e-06" ixy="0" ixz="0" iyy="6e-06" iyz="0" izz="6e-06"/></inertial>
    </link>
    <joint name="g_base_to_joint1" type="fixed">
      <parent link="${prefix}g_base"/><child link="${prefix}joint1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="joint2_to_joint1" type="revolute">
      <parent link="${prefix}joint1"/><child link="${prefix}joint2"/>
      <origin xyz="0 0 0.13156" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-2.9321" upper="2.9321" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="joint3_to_joint2" type="revolute">
      <parent link="${prefix}joint2"/><child link="${prefix}joint3"/>
      <origin xyz="0 0 0" rpy="0 1.5708 -1.5708"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-2.4434" upper="2.4434" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="joint4_to_joint3" type="revolute">
      <parent link="${prefix}joint3"/><child link="${prefix}joint4"/>
      <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-2.6179" upper="2.6179" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="joint5_to_joint4" type="revolute">
      <parent link="${prefix}joint4"/><child link="${prefix}joint5"/>
      <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-2.6179" upper="2.6179" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="joint6_to_joint5" type="revolute">
      <parent link="${prefix}joint5"/><child link="${prefix}joint6"/>
      <origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-2.7052" upper="2.7925" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="joint6output_to_joint6" type="revolute">
      <parent link="${prefix}joint6"/><child link="${prefix}joint6_flange"/>
      <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-3.14159" upper="3.14159" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="joint6output_to_gripper_base" type="fixed">
      <parent link="${prefix}joint6_flange"/><child link="${prefix}gripper_base"/>
      <origin xyz="0 0 0.034" rpy="1.579 0 -0.7854"/>
    </joint>
    <joint name="gripper_controller" type="revolute">
      <parent link="${prefix}gripper_base"/><child link="${prefix}gripper_left3"/>
      <origin xyz="-0.012 0.005 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-0.74" upper="0.15" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="gripper_base_to_gripper_left2" type="revolute">
      <parent link="${prefix}gripper_base"/><child link="${prefix}gripper_left2"/>
      <origin xyz="-0.005 0.027 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-0.8" upper="0.5" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="gripper_left3_to_gripper_left1" type="revolute">
      <parent link="${prefix}gripper_left3"/><child link="${prefix}gripper_left1"/>
      <origin xyz="-0.027 0.016 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-0.5" upper="0.5" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="gripper_base_to_gripper_right3" type="revolute">
      <parent link="${prefix}gripper_base"/><child link="${prefix}gripper_right3"/>
      <origin xyz="0.012 0.005 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-0.15" upper="0.7" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="gripper_base_to_gripper_right2" type="revolute">
      <parent link="${prefix}gripper_base"/><child link="${prefix}gripper_right2"/>
      <origin xyz="0.005 0.027 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-0.5" upper="0.8" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="gripper_right3_to_gripper_right1" type="revolute">
      <parent link="${prefix}gripper_right3"/><child link="${prefix}gripper_right1"/>
      <origin xyz="0.027 0.016 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" lower="-0.5" upper="0.5" velocity="3.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <gazebo reference="${prefix}gripper_left1"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
    <gazebo reference="${prefix}gripper_right1"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
</robot>
